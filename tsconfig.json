{
    "compilerOptions": {
        "module": "esnext",
        "lib": ["ES2023"],
        "target": "ES2023",
        "moduleResolution": "Node",
        "outDir": "dist",
        "baseUrl": "src/",
        "sourceMap": true,
        "strict": true,
        "experimentalDecorators": true,
        "noImplicitReturns": true,
        "allowSyntheticDefaultImports": true,
        "allowUnreachableCode": false,
        "incremental": true
    },
    "exclude": ["node_modules", "src/**/*.spec.ts", "src/arena/**/*", "test/**/*", "cli/**/*"]
}
